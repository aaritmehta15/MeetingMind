# LLM Provider API Keys (choose at least one)
# Groq (free tier — https://console.groq.com)
GROQ_API_KEY=your_groq_key_here

# Google Gemini (free tier — https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_key_here

# Default provider: groq | gemini | ollama
LLM_PROVIDER=groq

# Groq model (default works on free tier)
GROQ_MODEL=llama-3.3-70b-versatile

# Gemini model (default works on free tier)
GEMINI_MODEL=gemini-2.0-flash

# Ollama model (fully local, no API key needed)
OLLAMA_MODEL=llama3.2
